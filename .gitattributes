# Preserve the byte-level fingerprints of code, configuration and evidence.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.txt text eol=lf
Makefile text eol=lf
*.pdf binary
*.png binary
*.joblib binary
*.pptx binary

# Keep upstream library and font license bytes intact.
presentation/web/dist/vendor/* -whitespace
